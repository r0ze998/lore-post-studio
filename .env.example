# すべて任意（PC で使う場合）。Web（Vercel）で使う場合は docs/DEPLOY.md を参照。

# --- 保存先 ---
# 既定はローカルファイル（DATA_DIR、既定 ./data）
# DATA_DIR=./data
# Web 版（Vercel）では Supabase を使う
# STORAGE_BACKEND=supabase
# DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=        # サーバー専用の秘密鍵（sb_secret_...）。NEXT_PUBLIC_ を付けないこと
#                              （従来の service_role キーを使う場合は SUPABASE_SERVICE_ROLE_KEY）
# SUPABASE_BUCKET=lore-post-studio
# MAX_ASSET_MB=50

# --- ログイン ---
# LAN・Web で使うときの合言葉（Basic 認証、ユーザー名は user）。Vercel では 12 文字以上が必須。
# APP_PASSCODE=

# --- 文章生成（任意・有料） ---
# Anthropic API を使う場合のみ。キーはサーバー側でのみ読み込み、ブラウザには送りません。
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- テスト用 ---
# ENABLE_MOCK_PROVIDER=1
